{
  "expo": {
    "name": "CulinaPOS",
    "slug": "culina-pos",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/mylogo.png",
    "scheme": "culinapos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.culinapos.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-document-picker",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#C1121F",
          "defaultChannel": "low-stock-alerts"
        }
      ],
      [
        "react-native-thermal-printer-driver",
        {
          "bluetoothAlwaysPermission": "Culina POS connects to your Bluetooth receipt printer."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#39451F",
        "foregroundImage": "./assets/mylogo-no-bg.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.culinapos.app",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/mylogo.png",
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0cf1a11-fb8d-46b6-88bb-de3d6bbfab59"
      }
    }
  }
}
